{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.css", "/*.js", "/*.png", "/*.jpg", "/*.svg", "/api/*"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "routes": [
    {
      "route": "/cabin",
      "rewrite": "/cabin/index.html"
    },
    {
      "route": "/book",
      "rewrite": "/book/index.html"
    },
    {
      "route": "/track",
      "rewrite": "/track/index.html"
    },
    {
      "route": "/receipt",
      "rewrite": "/receipt/index.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact/index.html"
    },
    {
      "route": "/services",
      "rewrite": "/services/index.html"
    },
    {
      "route": "/flights",
      "rewrite": "/flights/index.html"
    },
    {
      "route": "/weather",
      "rewrite": "/weather/index.html"
    },
    {
      "route": "/experience",
      "rewrite": "/experience/index.html"
    },
    {
      "route": "/fairness",
      "rewrite": "/fairness/index.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy/index.html"
    },
    {
      "route": "/driver-dashboard*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/ops/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.js",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.css",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      }
    }
  ],
  "responseOverrides": {},
  "auth": {
    "identityProviders": {}
  }
}